<Window x:Class="ATCsim.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ATCsim.UI.Views"
        xmlns:vm="clr-namespace:ATCsim.UI.ViewModels"
        mc:Ignorable="d"
        Title="ATCsim - Tactical Air Traffic Control Console" 
        Height="720" Width="1180"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top Simulator Controls Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Flight Route Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Tactical Workspace (Radar + Inspector + Logs) -->
            <RowDefinition Height="*"/>
            <!-- 4. Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Controls Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Branding and Menus -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="File" FontFamily="Montserrat, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#212529" Margin="0,0,16,0" Cursor="Hand"/>
                    <TextBlock Text="View" FontFamily="Montserrat, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#212529" Margin="0,0,16,0" Cursor="Hand"/>
                    <TextBlock Text="Add" FontFamily="Montserrat, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#212529" Margin="0,0,16,0" Cursor="Hand"/>
                    <TextBlock Text="Simulation" FontFamily="Montserrat, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#212529" Margin="0,0,24,0" Cursor="Hand"/>
                    <TextBlock Text="ATCSim / Tactical Console (Layered MVVM + SQLite)" 
                               FontFamily="Montserrat, Segoe UI" FontSize="11" Foreground="#868E96" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right Simulator Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Seed Input -->
                    <Border Background="#F8F9FA" BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="0" Padding="6,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SEED:" FontFamily="Montserrat, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#495057" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding SeedInput, UpdateSourceTrigger=PropertyChanged}" 
                                     FontFamily="Consolas, Segoe UI" FontSize="11" 
                                     Width="80" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                            <Button Content="↻" Command="{Binding GenerateWorldCommand}" 
                                    FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="#495057" Cursor="Hand" Margin="4,0,0,0" ToolTip="Regenerate sector and save to SQLite"/>
                        </StackPanel>
                    </Border>

                    <!-- Run Button -->
                    <Button Command="{Binding RunCommand}" 
                            Background="#2B8A3E" Foreground="#FFFFFF" 
                            BorderThickness="0" Padding="14,5" Margin="0,0,6,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶ " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="Run" FontFamily="Montserrat, Segoe UI" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Pause Button -->
                    <Button Command="{Binding PauseCommand}" 
                            Background="#F1F3F5" Foreground="#212529" 
                            BorderBrush="#CED4DA" BorderThickness="1" Padding="14,5" Margin="0,0,6,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏸ " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="Pause" FontFamily="Montserrat, Segoe UI" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Speed Toggle (1x, 2x, 4x) -->
                    <Button Command="{Binding ToggleSpeedCommand}" 
                            Content="{Binding SpeedLabel}" 
                            Background="#F1F3F5" Foreground="#212529" 
                            BorderBrush="#CED4DA" BorderThickness="1" 
                            FontFamily="Montserrat, Segoe UI" FontWeight="Bold" FontSize="11"
                            Padding="12,5" Margin="0,0,12,0" Cursor="Hand"/>

                    <!-- Add Aircraft -->
                    <Button Command="{Binding AddAircraftCommand}" 
                            Content="+ Add Aircraft" 
                            Background="#F8F9FA" Foreground="#212529" 
                            BorderBrush="#CED4DA" BorderThickness="1" 
                            FontFamily="Montserrat, Segoe UI" FontWeight="SemiBold" FontSize="11"
                            Padding="10,5" Margin="0,0,6,0" Cursor="Hand"/>

                    <!-- Add Zone -->
                    <Button Command="{Binding AddZoneCommand}" 
                            Content="+ Add Zone" 
                            Background="#F8F9FA" Foreground="#212529" 
                            BorderBrush="#CED4DA" BorderThickness="1" 
                            FontFamily="Montserrat, Segoe UI" FontWeight="SemiBold" FontSize="11"
                            Padding="10,5" Margin="0,0,6,0" Cursor="Hand"/>

                    <!-- Add Airport -->
                    <Button Command="{Binding AddAirportCommand}" 
                            Content="+ Add Airport" 
                            Background="#F8F9FA" Foreground="#212529" 
                            BorderBrush="#CED4DA" BorderThickness="1" 
                            FontFamily="Montserrat, Segoe UI" FontWeight="SemiBold" FontSize="11"
                            Padding="10,5" Margin="0,0,12,0" Cursor="Hand"/>

                    <!-- Square Exit & Save Button [ ✕ ] -->
                    <Button Command="{Binding ExitAndSaveCommand}" 
                            Width="26" Height="26"
                            Background="#C92A2A" Foreground="#FFFFFF" 
                            BorderThickness="0" 
                            Cursor="Hand" ToolTip="Зберегти прогрес у SQLite та завершити програму">
                        <TextBlock Text="✕" FontFamily="Montserrat, Segoe UI" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Responsive Flight Route Banner -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Departure Airport -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DEPARTURE" FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#868E96" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding DepIcao}" FontFamily="Montserrat, Segoe UI" FontSize="26" FontWeight="ExtraBold" Foreground="#212529" LineHeight="28"/>
                    <TextBlock Text="{Binding DepName}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#343A40"/>
                    <TextBlock Text="{Binding DepTimes}" FontFamily="Segoe UI" FontSize="10" Foreground="#868E96" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Center: Flight Progress & Route -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Callsign, Badge, ETA -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="✈ " FontSize="14" Foreground="#212529" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FlightCallsign}" FontFamily="Montserrat, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#212529" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding FlightModel}" FontFamily="Segoe UI" FontSize="12" Foreground="#495057" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Background="#EBFBEE" BorderBrush="#D3F9D8" BorderThickness="1" CornerRadius="0" Padding="6,2" Margin="0,0,12,0">
                            <TextBlock Text="{Binding FlightStatusBadge}" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#2B8A3E"/>
                        </Border>
                        <TextBlock Text="{Binding FlightEta}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#212529" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Responsive Progress Bar with Dynamic Plane Marker -->
                    <Grid Grid.Row="1" Height="20" Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding FlownGridLength}"/>
                            <ColumnDefinition Width="{Binding RemainingGridLength}"/>
                        </Grid.ColumnDefinitions>

                        <!-- Solid Flown Portion Bar (Green) -->
                        <Border Grid.Column="0" Background="#2B8A3E" Height="4" VerticalAlignment="Center" CornerRadius="0"/>
                        <!-- Remaining Portion Bar (Gray) -->
                        <Border Grid.Column="1" Background="#DEE2E6" Height="4" VerticalAlignment="Center" CornerRadius="0"/>

                        <!-- Plane Marker Centered on the Dynamic Split -->
                        <Border Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,-10,0"
                                Background="#FFFFFF" BorderBrush="#212529" BorderThickness="1" Width="20" Height="20" CornerRadius="0">
                            <TextBlock Text="✈" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#212529"/>
                        </Border>
                    </Grid>

                    <!-- Distances and Waypoints -->
                    <Grid Grid.Row="2" Margin="10,4,10,0">
                        <TextBlock Text="{Binding FlightDistanceFlown}" FontFamily="Segoe UI" FontSize="10" Foreground="#868E96" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding FlightRoute, StringFormat={}ROUTE: {0}}" 
                                   FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="#495057" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding FlightDistanceRemaining}" FontFamily="Segoe UI" FontSize="10" Foreground="#868E96" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>

                <!-- Right: Destination Airport -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="DESTINATION" FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#868E96" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding ArrIcao}" FontFamily="Montserrat, Segoe UI" FontSize="26" FontWeight="ExtraBold" Foreground="#212529" LineHeight="28"/>
                    <TextBlock Text="{Binding ArrName}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#343A40"/>
                    <TextBlock Text="{Binding ArrTimes}" FontFamily="Segoe UI" FontSize="10" Foreground="#868E96" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Tactical Workspace (Resizable with GridSplitter) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Radar Canvas (Adapts dynamically) -->
                <ColumnDefinition Width="*" MinWidth="400"/>
                <!-- Column 1: GridSplitter -->
                <ColumnDefinition Width="5"/>
                <!-- Column 2: Right Tactical Panel (Inspector & Comm Logs) -->
                <ColumnDefinition Width="420" MinWidth="340" MaxWidth="560"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Tactical Radar Canvas -->
            <Border Grid.Column="0" Background="#1E382B">
                <views:RadarCanvasView DataContext="{Binding Radar}"/>
            </Border>

            <!-- Column 1: User-Draggable Splitter for Responsive Resizing -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E9ECEF" Cursor="SizeWE"/>

            <!-- Column 2: Tactical Right Panel -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Inspector (Top Half) -->
                        <RowDefinition Height="Auto"/>
                        <!-- System & Comm Logs (Bottom Half) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Flight & Airport Inspector -->
                    <StackPanel Grid.Row="0" Margin="16" DataContext="{Binding Inspector}">
                        <!-- Tab Switcher -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="INSPECTION" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#868E96" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="AIRCRAFT" Command="{Binding SwitchToAircraftTabCommand}"
                                        FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold"
                                        Padding="10,4" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F1F3F5"/>
                                            <Setter Property="Foreground" Value="#495057"/>
                                            <Setter Property="BorderBrush" Value="#CED4DA"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAircraftTab}" Value="True">
                                                    <Setter Property="Background" Value="#212529"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="AIRPORT" Command="{Binding SwitchToAirportTabCommand}"
                                        FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold"
                                        Padding="10,4" Margin="3,0,0,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F1F3F5"/>
                                            <Setter Property="Foreground" Value="#495057"/>
                                            <Setter Property="BorderBrush" Value="#CED4DA"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAirportTab}" Value="True">
                                                    <Setter Property="Background" Value="#212529"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- AIRCRAFT TAB VIEW -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAircraftTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Aircraft Summary Card -->
                            <Border Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" Padding="14,10" Margin="0,0,0,10" CornerRadius="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Callsign}" FontFamily="Montserrat, Segoe UI" FontSize="20" FontWeight="ExtraBold" Foreground="#212529"/>
                                        <TextBlock Text="{Binding ModelName}" FontFamily="Montserrat, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#343A40" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding OperatorName, StringFormat={}Operator: {0}}" FontFamily="Segoe UI" FontSize="11" Foreground="#868E96"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" VerticalAlignment="Top" Background="#EBFBEE" BorderBrush="#D3F9D8" BorderThickness="1" Padding="6,2" CornerRadius="0">
                                        <TextBlock Text="{Binding Status}" FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#2B8A3E"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Telemetry 2x2 Grid -->
                            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,12">
                                <!-- Altitude Card -->
                                <Border Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1" Padding="10,7" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="ALTITUDE" FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#868E96"/>
                                        <TextBlock Text="{Binding AltitudeFormatted}" FontFamily="Consolas, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#7048E8" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding FlFormatted}" FontFamily="Consolas, Segoe UI" FontSize="10" Foreground="#868E96"/>
                                    </StackPanel>
                                </Border>

                                <!-- Ground Speed Card -->
                                <Border Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1" Padding="10,7" Margin="4,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="GROUND SPEED" FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#868E96"/>
                                        <TextBlock Text="{Binding GroundSpeedFormatted}" FontFamily="Consolas, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#212529" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding KmhFormatted}" FontFamily="Consolas, Segoe UI" FontSize="10" Foreground="#868E96"/>
                                    </StackPanel>
                                </Border>

                                <!-- Heading Card -->
                                <Border Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1" Padding="10,7" Margin="0,4,4,0">
                                    <StackPanel>
                                        <TextBlock Text="HEADING" FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#868E96"/>
                                        <TextBlock Text="{Binding HeadingFormatted}" FontFamily="Consolas, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#212529" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding HeadingDirection}" FontFamily="Segoe UI" FontSize="10" Foreground="#868E96"/>
                                    </StackPanel>
                                </Border>

                                <!-- Fuel Card -->
                                <Border Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="1" Padding="10,7" Margin="4,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="FUEL REMAINING" FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#868E96"/>
                                        <TextBlock Text="{Binding FuelFormatted}" FontFamily="Consolas, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#212529" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding FuelPercent}" FontFamily="Segoe UI" FontSize="10" Foreground="#2B8A3E"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Dispatcher Instructions Section -->
                            <TextBlock Text="DISPATCHER INSTRUCTIONS (LIVE EXECUTION)" FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#868E96" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Rows="2">
                                <Button Command="{Binding TurnHeadingCommand}" Content="Turn Heading (+30°)" 
                                        Background="#FFFFFF" Foreground="#212529" BorderBrush="#CED4DA" BorderThickness="1" 
                                        FontFamily="Montserrat, Segoe UI" FontWeight="SemiBold" FontSize="11" Padding="0,7" Margin="0,0,4,4" Cursor="Hand"/>
                                <Button Command="{Binding ClimbDescendCommand}" Content="Climb / Descend" 
                                        Background="#FFFFFF" Foreground="#212529" BorderBrush="#CED4DA" BorderThickness="1" 
                                        FontFamily="Montserrat, Segoe UI" FontWeight="SemiBold" FontSize="11" Padding="0,7" Margin="4,0,0,4" Cursor="Hand"/>
                                <Button Command="{Binding DirectToUkbbCommand}" Content="Direct to UKBB" 
                                        Background="#FFFFFF" Foreground="#212529" BorderBrush="#CED4DA" BorderThickness="1" 
                                        FontFamily="Montserrat, Segoe UI" FontWeight="SemiBold" FontSize="11" Padding="0,7" Margin="0,4,4,0" Cursor="Hand"/>
                                <Button Command="{Binding HoldingPatternCommand}" Content="Holding Pattern" 
                                        Background="#FFFFFF" Foreground="#212529" BorderBrush="#CED4DA" BorderThickness="1" 
                                        FontFamily="Montserrat, Segoe UI" FontWeight="SemiBold" FontSize="11" Padding="0,7" Margin="4,4,0,0" Cursor="Hand"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- AIRPORT TAB VIEW (Direct SQLite Data) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAirportTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Airport Selector -->
                            <TextBlock Text="SELECT AERODROME (SQLite Data):" FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#868E96" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableAirports}" 
                                      SelectedItem="{Binding SelectedAirport}" 
                                      DisplayMemberPath="Name"
                                      FontFamily="Montserrat, Segoe UI" FontSize="11" Padding="6,4" Margin="0,0,0,10"/>

                            <!-- Airport Info Card -->
                            <Border Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" Padding="14,10" CornerRadius="0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{Binding SelectedAirport.Icao}" FontFamily="Montserrat, Segoe UI" FontSize="20" FontWeight="ExtraBold" Foreground="#212529"/>
                                        <Border HorizontalAlignment="Right" Background="#EBFBEE" BorderBrush="#D3F9D8" BorderThickness="1" Padding="6,2">
                                            <TextBlock Text="{Binding SelectedAirport.Status}" FontFamily="Montserrat" FontSize="9" FontWeight="Bold" Foreground="#2B8A3E"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedAirport.Name}" FontFamily="Montserrat, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#343A40"/>
                                    <Separator Margin="0,8" Background="#E9ECEF"/>
                                    <TextBlock Text="RUNWAYS:" FontFamily="Montserrat" FontSize="9" FontWeight="Bold" Foreground="#868E96"/>
                                    <TextBlock Text="{Binding SelectedAirport.RunwaysText}" FontFamily="Segoe UI" FontSize="11" Foreground="#212529" Margin="0,2,0,6"/>
                                    
                                    <TextBlock Text="ELEVATION &amp; CAPACITY:" FontFamily="Montserrat" FontSize="9" FontWeight="Bold" Foreground="#868E96"/>
                                    <TextBlock Text="{Binding SelectedAirport.ElevationText, StringFormat={}Elevation: {0}}" FontFamily="Segoe UI" FontSize="11" Foreground="#495057"/>
                                    <TextBlock Text="{Binding SelectedAirport.CapacityText, StringFormat={}Stands: {0}}" FontFamily="Segoe UI" FontSize="11" Foreground="#495057"/>

                                    <Button Command="{Binding DataContext.EditAirportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Content="✎ Редагувати характеристики / Edit Airport"
                                            Background="#FFFFFF" Foreground="#212529" BorderBrush="#CED4DA" BorderThickness="1"
                                            FontFamily="Montserrat, Segoe UI" FontWeight="SemiBold" FontSize="10"
                                            Padding="0,6" Margin="0,10,0,0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- System & Comm Logs Component (Bottom Half) -->
                    <Border Grid.Row="1" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0">
                        <views:LogJournalView DataContext="{Binding Logs}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ATCsim • Tactical Airspace Console" FontFamily="Montserrat, Segoe UI" FontSize="10" Foreground="#ADB5BD" VerticalAlignment="Center"/>

                <!-- Simulation clocks and weather -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SIM TIME: " FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#868E96"/>
                    <TextBlock Text="{Binding SimTimeText}" FontFamily="Consolas, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#212529" Margin="0,0,16,0"/>

                    <TextBlock Text="WIND: " FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#868E96"/>
                    <TextBlock Text="{Binding WindText}" FontFamily="Consolas, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#212529"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
