<Window x:Class="ATCsim.UI.Views.Dialogs.AddZoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Restricted Zone / Додати зону небезпеки" 
        Height="430" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="ADD RESTRICTED WEATHER / AIRSPACE ZONE" FontFamily="Montserrat, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#212529"/>
            <TextBlock Text="Встановлення метеорологічних та спеціальних зон обмеження" FontFamily="Segoe UI" FontSize="11" Foreground="#6C757D"/>
        </StackPanel>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Zone Name -->
                <TextBlock Text="ZONE DESIGNATOR / НАЗВА ЗОНИ:" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Text="RESTRICTED ZONE #05" FontFamily="Montserrat" FontSize="12" Padding="6,4" Margin="0,0,0,10" BorderBrush="#CED4DA"/>

                <!-- Zone Type -->
                <TextBlock Text="HAZARD TYPE / ТИП ОБМЕЖЕННЯ:" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                <ComboBox x:Name="TypeCombo" SelectedIndex="0" FontFamily="Segoe UI" FontSize="12" Padding="6,4" Margin="0,0,0,10">
                    <ComboBoxItem Content="STORM (Грозовий фронт / Конвективна активність)"/>
                    <ComboBoxItem Content="TURBULENCE (Зона сильної бовтанки)"/>
                    <ComboBoxItem Content="MILITARY (Спеціальний сектор операцій)"/>
                </ComboBox>

                <!-- Center Coordinates & Radius -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="CENTER X:" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                        <TextBox x:Name="CenterXBox" Text="650" FontFamily="Consolas" FontSize="12" Padding="6,4" BorderBrush="#CED4DA"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="CENTER Y:" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                        <TextBox x:Name="CenterYBox" Text="360" FontFamily="Consolas" FontSize="12" Padding="6,4" BorderBrush="#CED4DA"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                        <TextBlock Text="RADIUS (NM):" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                        <TextBox x:Name="RadiusBox" Text="50" FontFamily="Consolas" FontSize="12" Padding="6,4" BorderBrush="#CED4DA"/>
                    </StackPanel>
                </Grid>

                <!-- Altitudes -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="MIN ALT (FT):" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                        <TextBox x:Name="MinAltBox" Text="0" FontFamily="Consolas" FontSize="12" Padding="6,4" BorderBrush="#CED4DA"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="MAX ALT (FT):" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                        <TextBox x:Name="MaxAltBox" Text="30000" FontFamily="Consolas" FontSize="12" Padding="6,4" BorderBrush="#CED4DA"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Скасувати" Click="OnCancelClick" 
                    Background="#F1F3F5" Foreground="#495057" BorderBrush="#CED4DA" BorderThickness="1"
                    FontFamily="Montserrat, Segoe UI" FontWeight="SemiBold" FontSize="11" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Створити зону" Click="OnAddClick" 
                    Background="#C92A2A" Foreground="#FFFFFF" BorderThickness="0"
                    FontFamily="Montserrat, Segoe UI" FontWeight="Bold" FontSize="11" Padding="16,6" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
