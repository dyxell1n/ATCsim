<Window x:Class="ATCsim.UI.Views.Dialogs.AddAircraftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Aircraft / Додати новий літак" 
        Height="460" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="ADD AIRCRAFT TO AIRSPACE" FontFamily="Montserrat, Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#212529"/>
            <TextBlock Text="Створення нового борту з маршрутом та ешелоном польоту" FontFamily="Segoe UI" FontSize="11" Foreground="#6C757D"/>
        </StackPanel>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Callsign -->
                <TextBlock Text="CALLSIGN / ПОЗИВНИЙ:" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                <TextBox x:Name="CallsignBox" Text="AUI701" FontFamily="Montserrat, Consolas" FontSize="12" Padding="6,4" Margin="0,0,0,10" BorderBrush="#CED4DA"/>

                <!-- Aircraft Model -->
                <TextBlock Text="AIRCRAFT MODEL / ТИП ЛІТАКА:" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                <ComboBox x:Name="ModelCombo" SelectedIndex="0" FontFamily="Segoe UI" FontSize="12" Padding="6,4" Margin="0,0,0,10">
                    <ComboBoxItem Content="Boeing 737-800 (B738 - 450 kts)"/>
                    <ComboBoxItem Content="Airbus A320 (A320 - 450 kts)"/>
                    <ComboBoxItem Content="Embraer E195 (E195 - 430 kts)"/>
                    <ComboBoxItem Content="Airbus A321 (A321 - 460 kts)"/>
                </ComboBox>

                <!-- Departure Airport -->
                <TextBlock Text="DEPARTURE AERODROME / АЕРОПОРТ ВИЛЬОТУ:" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                <ComboBox x:Name="DepartureCombo" FontFamily="Segoe UI" FontSize="12" Padding="6,4" Margin="0,0,0,10" DisplayMemberPath="Display"/>

                <!-- Destination Airport -->
                <TextBlock Text="DESTINATION AERODROME / АЕРОПОРТ ПРИЛЬОТУ:" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                <ComboBox x:Name="ArrivalCombo" FontFamily="Segoe UI" FontSize="12" Padding="6,4" Margin="0,0,0,10" DisplayMemberPath="Display"/>

                <!-- Altitude -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="ALTITUDE (FT):" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                        <TextBox x:Name="AltitudeBox" Text="28000" FontFamily="Consolas" FontSize="12" Padding="6,4" BorderBrush="#CED4DA"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="SPEED (KTS):" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                        <TextBox x:Name="SpeedBox" Text="420" FontFamily="Consolas" FontSize="12" Padding="6,4" BorderBrush="#CED4DA"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Скасувати" Click="OnCancelClick" 
                    Background="#F1F3F5" Foreground="#495057" BorderBrush="#CED4DA" BorderThickness="1"
                    FontFamily="Montserrat, Segoe UI" FontWeight="SemiBold" FontSize="11" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Додати літак" Click="OnAddClick" 
                    Background="#2B8A3E" Foreground="#FFFFFF" BorderThickness="0"
                    FontFamily="Montserrat, Segoe UI" FontWeight="Bold" FontSize="11" Padding="16,6" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
