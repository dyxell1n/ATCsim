<UserControl x:Class="ATCsim.UI.Views.LogJournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header and Filter Tabs -->
        <Border Grid.Row="0" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="SYSTEM &amp; COMM LOGS" 
                           FontFamily="Montserrat, Segoe UI" 
                           FontWeight="Bold" 
                           FontSize="11" 
                           Foreground="#212529" 
                           VerticalAlignment="Center"/>

                <!-- Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="ALL" 
                            Command="{Binding FilterAllCommand}" 
                            FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="SemiBold"
                            Background="#212529" Foreground="#FFFFFF"
                            BorderThickness="0" Padding="8,3" Margin="2,0"/>
                    <Button Content="RADIO" 
                            Command="{Binding FilterRadioCommand}" 
                            FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="SemiBold"
                            Background="#F1F3F5" Foreground="#495057"
                            BorderBrush="#CED4DA" BorderThickness="1" Padding="8,3" Margin="2,0"/>
                    <Button Content="ALERTS" 
                            Command="{Binding FilterAlertsCommand}" 
                            FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="SemiBold"
                            Background="#F1F3F5" Foreground="#C92A2A"
                            BorderBrush="#CED4DA" BorderThickness="1" Padding="8,3" Margin="2,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log Items List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredLogs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#F1F3F5" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top line: Time, Tag, Sender -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time}" 
                                                   FontFamily="Segoe UI, Montserrat" FontSize="11" 
                                                   Foreground="#868E96" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Tag}" 
                                                   FontFamily="Montserrat, Segoe UI" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2B8A3E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                                            <Setter Property="Foreground" Value="#C92A2A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRadio}" Value="True">
                                                            <Setter Property="Foreground" Value="#212529"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Sender}" 
                                               FontFamily="Montserrat, Segoe UI" FontSize="10" 
                                               Foreground="#868E96" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- Message body -->
                                <TextBlock Grid.Row="1" Text="{Binding Message}" 
                                           FontFamily="Segoe UI" FontSize="11" Foreground="#343A40" 
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
