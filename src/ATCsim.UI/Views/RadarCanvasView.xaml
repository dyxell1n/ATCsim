<UserControl x:Class="ATCsim.UI.Views.RadarCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <!-- Interactive Tactical Radar Viewport: Pan with RMB drag, Zoom with Mouse Wheel -->
    <Grid x:Name="ViewportContainer" 
          Background="#1E382B" 
          ClipToBounds="True" 
          MouseWheel="OnMouseWheel"
          MouseRightButtonDown="OnMouseRightButtonDown"
          MouseRightButtonUp="OnMouseRightButtonUp"
          MouseMove="OnMouseMove"
          SizeChanged="OnViewportSizeChanged">

        <!-- Transformable Map Surface -->
        <Canvas x:Name="RadarCanvas" Width="1000" Height="700">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MapScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform x:Name="MapTranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- 1. Stylized Tactical Airspace Landmass Contours -->
            <!-- Base Water Surface -->
            <Polygon Points="0,0 1000,0 1000,700 0,700" Fill="#1E3A52" />
            
            <!-- Main Airspace Landmass -->
            <Polygon Points="0,0 1000,0 1000,520 860,540 680,510 570,550 510,640 460,700 0,700" Fill="#284E38" />
            
            <!-- Elevation and Sector Contours -->
            <Polygon Points="60,320 240,280 380,310 460,400 320,460 140,480" Fill="#37684B" Opacity="0.5" />
            <Polygon Points="420,220 720,180 840,280 780,380 540,360 460,280" Fill="#37684B" Opacity="0.4" />
            <Polygon Points="380,480 620,440 680,540 540,620 440,580" Fill="#457858" Opacity="0.35" />

            <!-- 2. Clean Solid Radar Range Rings (Centered at Boryspil FIR: 580, 260) -->
            <!-- 20 NM Ring (radius 100) -->
            <Ellipse Canvas.Left="480" Canvas.Top="160" Width="200" Height="200"
                     Stroke="#E9ECEF" StrokeThickness="1" Opacity="0.35"/>
            <!-- 40 NM Ring (radius 200) -->
            <Ellipse Canvas.Left="380" Canvas.Top="60" Width="400" Height="400"
                     Stroke="#E9ECEF" StrokeThickness="1" Opacity="0.25"/>
            <!-- 60 NM Ring (radius 300) -->
            <Ellipse Canvas.Left="280" Canvas.Top="-40" Width="600" Height="600"
                     Stroke="#E9ECEF" StrokeThickness="1" Opacity="0.18"/>
            <!-- Range Ring Distance Labels -->
            <TextBlock Canvas.Left="585" Canvas.Top="165" Text="20 NM" 
                       FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#CED4DA" Opacity="0.8"/>
            <TextBlock Canvas.Left="585" Canvas.Top="65" Text="40 NM" 
                       FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#CED4DA" Opacity="0.7"/>

            <!-- 3. Dynamic Altitude-Gradient Breadcrumb Trails (Drawn every second per aircraft) -->
            <ItemsControl ItemsSource="{Binding AllTrailSegments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                              Stroke="{Binding StrokeBrush}" StrokeThickness="3.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Opacity="0.85"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 4. Restricted Weather Zone (Solid Red Boundary with Radial Glow) -->
            <Ellipse Canvas.Left="405" Canvas.Top="145" Width="110" Height="110"
                     Stroke="#C92A2A" StrokeThickness="1.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#90C92A2A" Offset="0.0"/>
                        <GradientStop Color="#20C92A2A" Offset="0.8"/>
                        <GradientStop Color="#00C92A2A" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Border Canvas.Left="425" Canvas.Top="180" Background="#FFFFFF" BorderBrush="#C92A2A" BorderThickness="1" Padding="6,3" CornerRadius="0">
                <StackPanel>
                    <TextBlock Text="RESTRICTED ZONE #04" FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#C92A2A"/>
                    <TextBlock Text="Storm Hazard (FL0 - FL220)" FontFamily="Segoe UI" FontSize="8" Foreground="#495057"/>
                </StackPanel>
            </Border>

            <!-- 5. Waypoints (Solid Markers with Text) -->
            <!-- TMR -->
            <Ellipse Canvas.Left="257" Canvas.Top="377" Width="6" Height="6" Fill="#FF8787"/>
            <TextBlock Canvas.Left="266" Canvas.Top="373" Text="TMR" FontFamily="Montserrat" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
            <!-- SLV -->
            <Ellipse Canvas.Left="377" Canvas.Top="327" Width="6" Height="6" Fill="#FF8787"/>
            <TextBlock Canvas.Left="386" Canvas.Top="323" Text="SLV" FontFamily="Montserrat" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
            <!-- KVR -->
            <Ellipse Canvas.Left="477" Canvas.Top="287" Width="6" Height="6" Fill="#FF8787"/>
            <TextBlock Canvas.Left="486" Canvas.Top="283" Text="KVR" FontFamily="Montserrat" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
            <!-- BODRU -->
            <Ellipse Canvas.Left="527" Canvas.Top="447" Width="6" Height="6" Fill="#74C0FC"/>
            <TextBlock Canvas.Left="536" Canvas.Top="443" Text="BODRU" FontFamily="Montserrat" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
            <!-- PEKIT -->
            <Ellipse Canvas.Left="707" Canvas.Top="262" Width="6" Height="6" Fill="#FFD43B"/>
            <TextBlock Canvas.Left="716" Canvas.Top="258" Text="PEKIT" FontFamily="Montserrat" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>

            <!-- 6. Dynamic Interactive Airports (Clickable Beacons & Cards) -->
            <ItemsControl ItemsSource="{Binding Airports}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas Margin="-12,-12,0,0">
                            <!-- Clickable Airport Beacon Button -->
                            <Button Command="{Binding DataContext.SelectAirportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="24" Height="24"
                                    Background="#FFFFFF"
                                    BorderThickness="2"
                                    Cursor="Hand"
                                    Padding="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="BorderBrush" Value="#212529"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#2B8A3E"/>
                                                <Setter Property="Background" Value="#EBFBEE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Ellipse Width="6" Height="6" Fill="#212529"/>
                            </Button>

                            <!-- Airport Label Card (Clickable) -->
                            <Border Canvas.Left="26" Canvas.Top="-6"
                                    Background="#FFFFFF"
                                    BorderThickness="1"
                                    Padding="6,3"
                                    CornerRadius="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#CED4DA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#2B8A3E"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IcaoCode}" FontFamily="Montserrat" FontSize="10" FontWeight="Bold" Foreground="#212529" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="#495057"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" FontFamily="Segoe UI" FontSize="8" Foreground="#6C757D"/>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 7. Dynamic Moving Aircraft Tracks -->
            <ItemsControl ItemsSource="{Binding Tracks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas Margin="-14,-14,0,0">
                            <!-- Subtle Light Forward Heading Direction Vector -->
                            <Line X1="14" Y1="14" X2="{Binding VectorEndX}" Y2="{Binding VectorEndY}"
                                  Stroke="#F8F9FA" StrokeThickness="1.5" Opacity="0.85"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                            <!-- Plane Icon Button / Hitbox -->
                            <Button Command="{Binding DataContext.SelectTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="28" Height="28"
                                    Background="#FFFFFF"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Padding="3">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="BorderBrush" Value="#212529"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#2B8A3E"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="Background" Value="#EBFBEE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                <Setter Property="BorderBrush" Value="#C92A2A"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="Background" Value="#FFF5F5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <!-- Vector Plane SVG Icon -->
                                <Path Data="M10,2 L14,10 L22,12 L22,14 L14,15 L14,20 L17,22 L17,24 L10,22 L3,24 L3,22 L6,20 L6,15 L-2,14 L-2,12 L6,10 Z"
                                      Fill="#212529"
                                      Stretch="Uniform">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="{Binding Heading}" CenterX="10" CenterY="10"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Button>

                            <!-- Flight Telemetry Block Card: Hidden by default, highlighted on selection -->
                            <Border Canvas.Left="34" Canvas.Top="-10" 
                                    Background="#FFFFFF" 
                                    BorderBrush="#2B8A3E" 
                                    BorderThickness="1.5" 
                                    Padding="6,4" 
                                    CornerRadius="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="BorderBrush" Value="#C92A2A"/>
                                                <Setter Property="Background" Value="#FFF5F5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Callsign}" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#212529" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding ShortModel}" FontFamily="Montserrat, Segoe UI" FontSize="9" Foreground="#6C757D"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FlightLevelText}" FontFamily="Consolas, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#7048E8" Margin="0,0,4,0"/>
                                        <TextBlock Text="↑" FontFamily="Segoe UI" FontSize="9" Foreground="#2B8A3E" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding GroundSpeed, StringFormat={}{0} kts}" FontFamily="Consolas, Segoe UI" FontSize="9" Foreground="#212529"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Heading, StringFormat={}HDG {0:000}°}" FontFamily="Consolas, Segoe UI" FontSize="8" Foreground="#495057"/>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <!-- Static HUD Overlay: Pan/Zoom controls and Altitude Gradient Legend (Doesn't scale or pan) -->
        <!-- Top-Right Viewport Navigation Controls -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="12" Background="#FFFFFF" BorderBrush="#CED4DA" BorderThickness="1" Padding="8,4" CornerRadius="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🖱 Pan: Hold RMB | Zoom: Scroll" 
                           FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="#495057" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Click="OnResetViewClick" Content="⟲ Reset View" 
                        FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold"
                        Background="#F1F3F5" Foreground="#212529" BorderBrush="#CED4DA" BorderThickness="1" 
                        Padding="6,2" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Altitude Gradient Legend (Bottom-Left) -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                Margin="12" Background="#FFFFFF" BorderBrush="#CED4DA" BorderThickness="1" Padding="10,6" CornerRadius="0">
            <StackPanel Width="160">
                <TextBlock Text="ALTITUDE GRADIENT (FL)" 
                           FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,4"/>
                <!-- Solid continuous gradient strip -->
                <Border Height="8" CornerRadius="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FCC419" Offset="0.0"/>
                            <GradientStop Color="#F76707" Offset="0.45"/>
                            <GradientStop Color="#7048E8" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="FL050 (Low)" FontFamily="Segoe UI" FontSize="8" Foreground="#868E96" HorizontalAlignment="Left"/>
                    <TextBlock Text="FL360 (High)" FontFamily="Segoe UI" FontSize="8" Foreground="#868E96" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
