<UserControl x:Class="ATCsim.UI.Views.RadarCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AviationIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RadarMarkerButton" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#CED4DA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#212529"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#495057"/>
                        <Setter Property="Background" Value="#F1F3F5"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#2B8A3E"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="#2B8A3E"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Background" Value="#EBFBEE"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Free aircraft silhouettes; the transparent hit area never paints a card. -->
            <Style x:Key="AircraftOverlayButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Ellipse Width="32" Height="32" Fill="Transparent"
                                         Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"
                                         IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#CED4DA"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#2B8A3E"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="#2B8A3E"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasConflict}" Value="True">
                        <Setter Property="BorderBrush" Value="#C92A2A"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Interactive Tactical Radar Viewport: Pan with RMB drag, Zoom with Mouse Wheel -->
    <Grid x:Name="ViewportContainer" 
          Background="#1E382B" 
          ClipToBounds="True" 
          MouseWheel="OnMouseWheel"
          MouseRightButtonDown="OnMouseRightButtonDown"
          MouseRightButtonUp="OnMouseRightButtonUp"
          MouseMove="OnMouseMove"
          SizeChanged="OnViewportSizeChanged">

        <!-- Transformable Map Surface -->
        <Canvas x:Name="RadarCanvas" Width="1000" Height="700">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MapScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform x:Name="MapTranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Seed-generated coastline and terrain -->
            <Rectangle Width="1000" Height="700" Fill="#1E3A52" IsHitTestVisible="False"/>
            <ItemsControl ItemsSource="{Binding Terrain}" IsHitTestVisible="False" Width="1000" Height="700">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Polygon Points="{Binding Points}" Fill="{Binding Fill}"/>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 2. Clean Solid Radar Range Rings (Fixed radar reference: 580, 260) -->
            <!-- 20 NM Ring (radius 100) -->
            <Ellipse Canvas.Left="480" Canvas.Top="160" Width="200" Height="200"
                     Stroke="#E9ECEF" StrokeThickness="1" Opacity="0.35"/>
            <!-- 40 NM Ring (radius 200) -->
            <Ellipse Canvas.Left="380" Canvas.Top="60" Width="400" Height="400"
                     Stroke="#E9ECEF" StrokeThickness="1" Opacity="0.25"/>
            <!-- 60 NM Ring (radius 300) -->
            <Ellipse Canvas.Left="280" Canvas.Top="-40" Width="600" Height="600"
                     Stroke="#E9ECEF" StrokeThickness="1" Opacity="0.18"/>
            <!-- Range Ring Distance Labels -->
            <TextBlock Canvas.Left="585" Canvas.Top="165" Text="20 NM" 
                       FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#CED4DA" Opacity="0.8"/>
            <TextBlock Canvas.Left="585" Canvas.Top="65" Text="40 NM" 
                       FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#CED4DA" Opacity="0.7"/>

            <!-- 3. Dynamic Altitude-Gradient Breadcrumb Trails (Drawn every second per aircraft) -->
            <ItemsControl ItemsSource="{Binding AllTrailSegments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                              Stroke="{Binding StrokeBrush}" StrokeThickness="3.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Opacity="0.85"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Seed-generated weather hazards -->
            <ItemsControl ItemsSource="{Binding WeatherZones}" Width="1000" Height="700" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style></ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Width="{Binding Diameter}" Height="{Binding Diameter}">
                        <Ellipse Stroke="#C92A2A" StrokeThickness="1.5" Fill="#30C92A2A"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Background="#FFFFFF">
                            <TextBlock Text="{Binding Name}" FontSize="9" Foreground="#C92A2A" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Description}" FontSize="8" Foreground="#495057"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Seed-generated navigation waypoints -->
            <ItemsControl ItemsSource="{Binding Waypoints}" Width="1000" Height="700" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding CoordX}"/>
                    <Setter Property="Canvas.Top" Value="{Binding CoordY}"/>
                </Style></ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#FF8787"/>
                        <TextBlock Text="{Binding Name}" Margin="4,0,0,0" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 6. Dynamic Interactive Airports (Clickable Beacons & Cards) -->
            <ItemsControl ItemsSource="{Binding Airports}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas Margin="-16,-16,0,0">
                            <!-- Clickable Airport Beacon Button -->
                            <Button Command="{Binding DataContext.SelectAirportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="32" Height="32" Style="{StaticResource RadarMarkerButton}"
                                    ToolTip="{Binding Name}" AutomationProperties.Name="{Binding IcaoCode}">
                                <Path Data="{StaticResource AirportIcon}" Width="22" Height="22"
                                      Stretch="Uniform" Fill="#212529"/>
                            </Button>

                            <!-- Airport Label Card (Clickable) -->
                            <Button Canvas.Left="38" Canvas.Top="-2" Padding="6,3"
                                    Style="{StaticResource RadarMarkerButton}"
                                    Command="{Binding DataContext.SelectAirportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="{Binding Name}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IcaoCode}" FontFamily="Montserrat" FontSize="10" FontWeight="Bold" Foreground="#212529" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="#495057"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" FontFamily="Segoe UI" FontSize="8" Foreground="#6C757D"/>
                                </StackPanel>
                            </Button>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 7. Dynamic Moving Aircraft Tracks -->
            <ItemsControl ItemsSource="{Binding Tracks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas Margin="-17,-17,0,0">
                            <!-- Subtle Light Forward Heading Direction Vector -->
                            <Line X1="17" Y1="17" X2="{Binding VectorEndX}" Y2="{Binding VectorEndY}"
                                  Stroke="#F8F9FA" StrokeThickness="1.5" Opacity="0.85"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                            <!-- Plane Icon Button / Hitbox -->
                            <Button Command="{Binding DataContext.SelectTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="34" Height="34" Style="{StaticResource AircraftOverlayButton}"
                                    ToolTip="{Binding ModelName}" AutomationProperties.Name="{Binding Callsign}">
                                <!-- Rotate the glyph while keeping its transparent hit target fixed. -->
                                <Grid Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="{Binding Heading}"/>
                                    </Grid.RenderTransform>
                                    <Path Data="{Binding IconGeometry}" Fill="#212529" Stretch="Uniform"
                                          Stroke="#F8F9FA" StrokeThickness="0.8" StrokeLineJoin="Round"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Button>

                            <!-- Flight Telemetry Block Card: Hidden by default, highlighted on selection -->
                            <Border Canvas.Left="40" Canvas.Top="-7"
                                    BorderThickness="1.5"
                                    Padding="6,4" 
                                    CornerRadius="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#2B8A3E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="BorderBrush" Value="#C92A2A"/>
                                                <Setter Property="Background" Value="#FFF5F5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Callsign}" FontFamily="Montserrat, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#212529" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding ShortModel}" FontFamily="Montserrat, Segoe UI" FontSize="9" Foreground="#6C757D"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FlightLevelText}" FontFamily="Consolas, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#7048E8" Margin="0,0,4,0"/>
                                        <TextBlock Text="↑" FontFamily="Segoe UI" FontSize="9" Foreground="#2B8A3E" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding GroundSpeed, StringFormat={}{0} kts}" FontFamily="Consolas, Segoe UI" FontSize="9" Foreground="#212529"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Heading, StringFormat={}HDG {0:000}°}" FontFamily="Consolas, Segoe UI" FontSize="8" Foreground="#495057"/>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <!-- Static HUD Overlay: Pan/Zoom controls and Altitude Gradient Legend (Doesn't scale or pan) -->
        <!-- Top-Right Viewport Navigation Controls -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="12" Background="#FFFFFF" BorderBrush="#CED4DA" BorderThickness="1" Padding="8,4" CornerRadius="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🖱 Pan: Hold RMB | Zoom: Scroll" 
                           FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="#495057" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Click="OnResetViewClick" Content="⟲ Reset View" 
                        FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold"
                        Background="#F1F3F5" Foreground="#212529" BorderBrush="#CED4DA" BorderThickness="1" 
                        Padding="6,2" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Altitude Gradient Legend (Bottom-Left) -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                Margin="12" Background="#FFFFFF" BorderBrush="#CED4DA" BorderThickness="1" Padding="10,6" CornerRadius="0">
            <StackPanel Width="160">
                <TextBlock Text="ALTITUDE GRADIENT (FL)" 
                           FontFamily="Montserrat, Segoe UI" FontSize="9" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,4"/>
                <!-- Solid continuous gradient strip -->
                <Border Height="8" CornerRadius="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FCC419" Offset="0.0"/>
                            <GradientStop Color="#F76707" Offset="0.45"/>
                            <GradientStop Color="#7048E8" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="FL050 (Low)" FontFamily="Segoe UI" FontSize="8" Foreground="#868E96" HorizontalAlignment="Left"/>
                    <TextBlock Text="FL360 (High)" FontFamily="Segoe UI" FontSize="8" Foreground="#868E96" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

