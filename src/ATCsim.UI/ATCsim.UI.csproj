<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ATCsim.Core\ATCsim.Core.csproj" />
    <ProjectReference Include="..\ATCsim.Data\ATCsim.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Content Include="Presets\*.atcpreset" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="Saves\*.atcsave" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="Presets\*.atcpreset" LogicalName="Examples/Presets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Saves\*.atcsave" LogicalName="Examples/Saves/%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
